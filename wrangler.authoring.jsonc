{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "concept-clusters-authoring",
  "main": "src/authoring-worker.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTHORING_DB",
      "database_name": "concept-clusters-authoring",
      "database_id": "726254cf-2847-42a0-b061-7900342cfd7c",
      "migrations_dir": "d1/migrations"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "concept_clusters_authoring_events" }
  ],
  "vars": {
    "AUTHORING_HOSTNAME": "concept-clusters-authoring.jmajerus.workers.dev",
    "AUTHORING_DEV_SUBJECT": "local-author",
    "TEAM_DOMAIN": "https://linkbud.cloudflareaccess.com",
    "POLICY_AUD": "ae4fd234734e3fe37f8d4231dda427bf66c2fb84efafae2be46c79c7b350a5d7",
    "GITHUB_OWNER": "jmajerus",
    "GITHUB_REPOSITORY": "concept-clusters",
    "GITHUB_BASE_BRANCH": "main"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "dev": {
    "port": 8788
  }
}
