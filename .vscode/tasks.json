{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MCP: restart stdio",
      "type": "npm",
      "script": "mcp:restart",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": {
        "owner": "concept-clusters-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Concept Clusters ready at"
        }
      }
    },
    {
      "label": "Dev worker",
      "type": "npm",
      "script": "dev:worker",
      "hide": true,
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": {
        "owner": "concept-clusters-dev-worker",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Concept Clusters ready at|Ready on"
        }
      }
    },
    {
      "label": "Dev: stop",
      "type": "npm",
      "script": "dev:stop",
      "problemMatcher": []
    },
    {
      "label": "Deploy game",
      "type": "npm",
      "script": "deploy",
      "problemMatcher": []
    },
    {
      "label": "Deploy MCP",
      "type": "npm",
      "script": "mcp:hosted:deploy",
      "problemMatcher": []
    },
    {
      "label": "Deploy Authoring",
      "type": "npm",
      "script": "authoring:deploy",
      "problemMatcher": []
    },
    {
      "label": "Deploy Authoring: main",
      "type": "shell",
      "command": "npm run authoring:deploy -- --main",
      "problemMatcher": []
    },
    {
      "label": "Deploy Authoring: PR",
      "type": "shell",
      "command": "npm run authoring:deploy -- --pr ${input:authoringPr}",
      "problemMatcher": []
    },
    {
      "label": "Test: Standard",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Monster Mash",
      "type": "npm",
      "script": "test:all",
      "problemMatcher": []
    },
    {
      "label": "Content stats",
      "type": "npm",
      "script": "content:stats",
      "problemMatcher": []
    },
    {
      "label": "Open local",
      "type": "npm",
      "script": "local",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Import Star layout",
      "type": "npm",
      "script": "import:star-layout",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "authoringPr",
      "type": "promptString",
      "description": "Pull request number to deploy to the authoring server"
    }
  ]
}
