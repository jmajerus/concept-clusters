{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Worker with static assets — serves the site (same static
  // files as the former Pages deployment) plus /api/event for gameplay
  // analytics and /admin for a dashboard over them (see src/admin.js — needs the
  // ADMIN_KEY and API_TOKEN secrets set via `wrangler secret put`,
  // documented there).
  // Deploy: npx wrangler deploy
  "name": "concept-clusters",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-22",
  "assets": {
    // Symlinked public tree, not the repo root: wrangler writes under
    // .wrangler/ and watching that from assets.directory "." restart-loops.
    "directory": "./site",
    "binding": "ASSETS",
    // The HTML entry points need a public-play bootstrap meta tag; API and
    // admin routes also need to reach the Worker script.
    "run_worker_first": ["/", "/index.html", "/api/*", "/admin", "/admin/*"]
  },
  "vars": {
    // Not a secret -- the account ID is not sensitive on its own, only
    // usable in combination with an actual credential (API_TOKEN, set
    // as a secret below). Matches Letter Punk's own wrangler.toml.
    "ACCOUNT_ID": "eec00739050a8a4cbf359a1dedb8cad3"
  },
  "d1_databases": [
    {
      "binding": "AUTHORING_DB",
      "database_name": "concept-clusters-authoring",
      "database_id": "726254cf-2847-42a0-b061-7900342cfd7c",
      "migrations_dir": "d1/migrations"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "concept_clusters_events" }
  ]
}
