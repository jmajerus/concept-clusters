{
  "name": "concept-clusters",
  "private": true,
  "type": "module",
  "description": "A D3.js concept-mapping puzzle game — static site, no build step. See docs/DEVELOPMENT.md.",
  "scripts": {
    "test": "npm run -s puzzles:build-manifest && node tests/run.mjs",
    "test:quick": "npm run -s puzzles:build-manifest && node tests/run.mjs --quick",
    "test:standard": "npm run -s puzzles:build-manifest && node tests/run.mjs --standard",
    "test:extended": "npm run -s puzzles:build-manifest && node tests/run.mjs --extended",
    "test:all": "npm run -s puzzles:build-manifest && node tests/run.mjs --all",
    "test:play": "npm run -s puzzles:build-manifest && node tests/run.mjs --standard --side=play",
    "test:authoring": "npm run -s puzzles:build-manifest && node tests/run.mjs --standard --side=authoring",
    "test:shared": "npm run -s puzzles:build-manifest && node tests/run.mjs --standard --side=shared",
    "validate": "node validate.mjs && node validate-categories.mjs && node validate-info-links.mjs",
    "check-wiki-links": "node tools/check-wiki-links.mjs",
    "skills:stamp": "node tools/stamp-skill-revision.mjs",
    "skills:check": "node tools/stamp-skill-revision.mjs --check",
    "content:export": "node tools/content-jsonld.mjs export",
    "content:import": "node tools/content-jsonld.mjs import",
    "content:check": "node tools/content-jsonld.mjs check",
    "content:stats": "node tools/puzzle-stats.mjs",
    "content:node-case-audit": "node tools/audit-node-case.mjs",
    "content:backfill": "node tools/backfill-canonical-content.mjs",
    "content:normalize-credits": "node tools/normalize-lesson-credits.mjs",
    "content:propagate-category-renames": "node tools/propagate-category-renames.mjs",
    "content:lift-legacy-board": "node tools/lift-legacy-board.mjs",
    "content:backfill-first-published": "node tools/backfill-first-published.mjs",
    "content:migrate-category-identifiers": "node tools/migrate-category-identifiers.mjs",
    "content:canonicalize": "node tools/canonicalize-content.mjs",
    "puzzles:ensure-registry": "node tools/ensure-puzzle-registry.mjs",
    "puzzles:build-manifest": "node tools/build-puzzle-manifest.mjs",
    "layouts:auto": "node tools/layouts-auto.mjs",
    "mcp": "node tools/mcp-server.mjs",
    "mcp:stdio": "node tools/mcp-server.mjs",
    "mcp:housekeep": "node tools/mcp-housekeep.mjs",
    "mcp:prune": "node tools/mcp-housekeep.mjs --kill --keep 1",
    "mcp:restart": "node tools/mcp-housekeep.mjs --restart",
    "mcp:portal:sync": "node tools/dispatch-mcp-portal-sync.mjs",
    "mcp:probe-report": "node tools/mcp-probe-report.mjs",
    "mcp:hosted:dev": "wrangler dev -c wrangler.authoring.jsonc",
    "mcp:hosted:deploy": "wrangler deploy -c wrangler.authoring.jsonc",
    "authoring:deploy": "node tools/authoring-deploy.mjs",
    "zotero:deploy": "node tools/zotero-deploy.mjs",
    "authoring:d1:migrate:local": "wrangler d1 migrations apply concept-clusters-authoring --local -c wrangler.authoring.jsonc",
    "authoring:d1:migrate:remote": "wrangler d1 migrations apply concept-clusters-authoring --remote -c wrangler.authoring.jsonc",
    "authoring:postgres:migrate": "node tools/postgres-migrate.mjs",
    "authoring:citations:refresh-usage": "node tools/sync-citation-usage.mjs",
    "authoring:citations:sync-zotero": "node tools/sync-zotero-citations.mjs",
    "authoring:citations:backfill": "node tools/citation-backfill.mjs",
    "authoring:citations:collections": "node tools/citation-collections.mjs",
    "authoring:taxonomy:export": "node tools/export-taxonomy.mjs",
    "authoring:postgres:dump": "node tools/postgres-dump.mjs",
    "authoring:postgres:copy": "node tools/copy-authoring-to-postgres.mjs",
    "mcp:hosted:release": "npm run authoring:d1:migrate:remote && npm run mcp:hosted:deploy",
    "mcp:hosted:types": "wrangler types -c wrangler.authoring.jsonc src/authoring-worker-configuration.d.ts",
    "test:worker": "vitest run -c vitest.authoring.config.ts",
    "typecheck:worker": "tsc -p tsconfig.authoring.json",
    "dev": "npm run mcp:prune && node tools/dev-server.mjs",
    "dev:worker": "npm run mcp:prune && node tools/dev-server.mjs --worker",
    "dev:stop": "node tools/dev-housekeep.mjs --kill",
    "dev:housekeep": "node tools/dev-housekeep.mjs",
    "deploy": "node tools/dispatch-play-deploy.mjs",
    "local": "node tools/open-local.mjs",
    "local:admin": "node tools/open-admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.0.1",
    "playwright": "^1.48.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.1",
    "jose": "^6.2.7",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  }
}
