{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-clusters.org/schema/bundle/v1",
  "title": "Concept Clusters portable catalogue bundle JSON-LD profile v1",
  "type": "object",
  "required": ["@context", "@id", "@type", "schemaVersion", "@graph"],
  "properties": {
    "@context": { "const": "https://concept-clusters.org/context/v1" },
    "@id": { "type": "string" },
    "@type": { "const": "CatalogueBundle" },
    "schemaVersion": { "const": "1.0" },
    "@graph": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "required": ["@id", "@type"] }
    }
  }
}
