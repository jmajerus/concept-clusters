{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-clusters.org/schemas/simplified-puzzle-v1.json",
  "$comment": "Reference copy of the schema actually enforced by modules/simplifiedPuzzleSchema.js (zod, not this file -- see that module's own comment). Kept in sync by hand, not generated; not imported by any runtime code, the same way puzzle-v1.schema.json (the JSON-LD counterpart) already isn't. See docs/SIMPLIFIED-PUZZLE-FORMAT.md for the authoring-facing version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "clusters"],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "info": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "link": { "type": "string", "minLength": 1 },
            "extraLink": { "type": "string", "minLength": 1 },
            "citations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "author": { "type": "string", "minLength": 1 },
                  "publisher": { "type": "string", "minLength": 1 },
                  "year": { "type": "string", "minLength": 1 },
                  "pages": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "subcategories": { "type": "object", "additionalProperties": { "$ref": "#/$defs/slug" } },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "large": { "type": "boolean" },
    "info": { "$ref": "#/$defs/info" },
    "clusters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "fact", "seeds", "floatingTerms"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1 },
          "color": {
            "type": "string",
            "enum": ["teal", "blue", "amber", "magenta", "olive", "brown", "cyan"],
            "description": "Auto-assigned, collision-free, when omitted."
          },
          "fact": { "type": "string", "minLength": 1 },
          "seeds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "floatingTerms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1 }
          },
          "termInfo": { "type": "object", "additionalProperties": { "$ref": "#/$defs/info" } },
          "info": { "$ref": "#/$defs/info" }
        }
      }
    },
    "bridges": {
      "type": "array",
      "description": "No minimum -- bridges are optional and need not make the cluster graph connected.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "clusters", "fact"],
        "properties": {
          "id": { "$ref": "#/$defs/slug", "description": "Derived from term when omitted." },
          "term": { "type": "string", "minLength": 1 },
          "clusters": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/slug" },
            "description": "Exactly 2 cluster ids from this document -- not fragments, not positions. Ternary bridges, direction, idealTerms, conceptId, and relationKind are out of scope here; author via JSON-LD for those."
          },
          "fact": { "type": "string", "minLength": 1 },
          "info": { "$ref": "#/$defs/info" }
        }
      }
    },
    "lenses": {
      "type": "array",
      "description": "Sequential-mode lenses only -- assignment/quiz lenses require JSON-LD.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "explanation", "targets"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "prompt": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "generativeAssistance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "scope"],
        "properties": {
          "system": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["learningIntroduction", "puzzle", "lenses"] },
          "role": { "type": "string", "enum": ["drafted", "edited"] },
          "provider": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
