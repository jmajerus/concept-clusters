{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-clusters.org/schema/catalogue/v1",
  "title": "Concept Clusters catalogue manifest JSON-LD profile v1",
  "type": "object",
  "required": ["@context", "@id", "@type", "schemaVersion", "id", "title", "entries"],
  "properties": {
    "@context": { "const": "https://concept-clusters.org/context/v1" },
    "@id": { "type": "string", "pattern": "^urn:concept-clusters:catalogue:" },
    "@type": { "const": "Catalogue" },
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "info": { "type": "object" },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["@id", "@type", "puzzle"],
        "properties": {
          "@id": { "type": "string" }, "@type": { "const": "CatalogueEntry" },
          "puzzle": { "type": "object", "required": ["@id"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
