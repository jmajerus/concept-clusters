  "title": "The Work of Color",
  "category": "Art",
  "subcategories": {
    "Art": "visual-form"
  },
  "large": true,
  "info": {
    "text": "Color can describe, organize, emphasize, suggest space, shape mood, and carry meaning through both its properties and its relationships.",
    "link": "wiki:Color theory"
  },
