  "lenses": [
    {
      "@id": "#lens-depends-on-comparison",
      "@type": "Lens",
      "id": "depends-on-comparison",
      "prompt": "Which concepts depend especially on comparing one color or area with another?",
      "targets": [
        "value",
        "complementary colors",
        "analogous colors",
        "contrast",
        "figure-ground",
        "simultaneous contrast"
      ],
      "explanation": "These concepts become meaningful through comparison: light against dark, neighboring hues, a figure against its field, or one color altered by what surrounds it.",
      "reasons": {
        "value": "Lightness and darkness are perceived comparatively within the surrounding range.",
        "complementary colors": "A complementary pair is defined by a relationship between hues.",
        "analogous colors": "Analogous colors are identified by their proximity to one another on a color model.",
        "contrast": "Contrast requires a noticeable difference between visual areas.",
        "figure-ground": "Figure-ground organization depends on distinguishing a form from its surrounding field.",
        "simultaneous contrast": "The effect specifically describes how adjacent colors alter one another's appearance."
      }
    },
    {
      "@id": "#lens-can-create-emphasis",
      "@type": "Lens",
      "id": "can-create-emphasis",
      "prompt": "Which concepts can help one area stand out from the rest of an image?",
      "targets": [
        "saturation",
        "complementary colors",
        "limited palette",
        "contrast",
        "figure-ground",
        "expressive color"
      ],
      "explanation": "An area can become prominent through greater intensity, strong hue opposition, separation from a restrained palette, clear figure-ground distinction, or deliberate departure from expected color.",
      "reasons": {
        "saturation": "A highly saturated area can stand out among muted surroundings.",
        "complementary colors": "Complementary hues can produce strong visual opposition.",
        "limited palette": "Restricting most colors can make a rare exception unusually conspicuous.",
        "contrast": "Strong difference attracts attention.",
        "figure-ground": "A clearly separated figure is easier to notice against its field.",
        "expressive color": "Unexpected or intensified color can draw attention to a form or feeling."
      }
    },
    {
      "@id": "#lens-can-suggest-depth",
      "@type": "Lens",
      "id": "can-suggest-depth",
      "prompt": "Which concepts can contribute to the appearance of depth or spatial layering?",
      "targets": [
        "value",
        "saturation",
        "atmospheric perspective",
        "figure-ground",
        "color temperature"
      ],
      "explanation": "Depth can be suggested through light-dark modeling, reduced intensity in distant forms, atmospheric change, separation of figure and field, and warm-cool relationships that appear to advance or recede.",
      "reasons": {
        "value": "Value differences can model volume and distinguish nearer from farther planes.",
        "saturation": "Distant forms are often represented with lower saturation.",
        "atmospheric perspective": "This convention uses reduced contrast and altered color to suggest distance.",
        "figure-ground": "Separating a figure from its field establishes a basic spatial relationship.",
        "color temperature": "Warm and cool relationships can contribute to perceived advance and recession."
      }
    },
    {
      "@id": "#lens-context-shapes-meaning",
      "@type": "Lens",
      "id": "context-shapes-meaning",
      "prompt": "Which concepts require contextual evidence before their meaning can be interpreted confidently?",
      "targets": [
        "symbolic color",
        "naturalistic color",
        "expressive color",
        "emotional tone",
        "color association"
      ],
      "explanation": "These uses of color cannot be decoded reliably from a universal chart. Their significance depends on the artwork's subject, conventions, purpose, audience, and cultural or historical setting.",
      "reasons": {
        "symbolic color": "A symbolic meaning depends on a particular cultural or artistic convention.",
        "naturalistic color": "Judging naturalism requires knowing what is represented and under what conditions.",
        "expressive color": "Its purpose must be inferred from the artwork rather than from hue alone.",
        "emotional tone": "Mood emerges from the whole visual context and the viewer's interpretive situation.",
        "color association": "Associations vary across communities, periods, and uses."
      }
    }
  ],
