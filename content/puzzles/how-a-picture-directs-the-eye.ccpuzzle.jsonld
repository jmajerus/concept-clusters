      "termInfo": {
        "foreground": {
          "text": "The part of an image represented or perceived as nearest to the viewer.",
          "link": "wiki:Foreground, middleground, and background"
        },
        "background": {
          "text": "The part of an image represented or perceived as lying behind its principal forms.",
          "link": "wiki:Foreground, middleground, and background"
        },
        "overlap": {
          "text": "The partial covering of one depicted form by another, commonly interpreted as evidence that one is in front.",
          "link": "wiki:Depth perception"
        },
        "negative space": {
          "text": "The apparently empty or open area around and between represented forms.",
          "link": "wiki:Negative space"
        }
      },
      "info": {
        "link": "wiki:Composition (visual arts)"
      }
    },
